.page {
  min-height: 100vh;
  background: #f8fafc;
}

.hero {
  background: #13315c;
  color: #fff;
  padding: 56rpx 36rpx 28rpx;
}

.topline {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 24rpx;
  margin-bottom: 32rpx;
}

.badge {
  display: inline-flex;
  align-items: center;
  gap: 14rpx;
  min-height: 56rpx;
  padding: 0 20rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.14);
  color: #d9f99d;
  font-size: 24rpx;
  font-weight: 800;
}

.dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background: #d9f99d;
}

.top-note {
  color: rgba(255, 255, 255, 0.76);
  font-size: 24rpx;
}

.hero-title {
  display: block;
  font-size: 52rpx;
  line-height: 1.24;
  font-weight: 800;
}

.hero-desc {
  display: block;
  margin-top: 20rpx;
  color: rgba(255, 255, 255, 0.82);
  font-size: 28rpx;
  line-height: 1.7;
}

.content {
  padding: 28rpx;
  display: grid;
  gap: 20rpx;
}

.section {
  background: #fff;
  border: 1rpx solid #e2e8f0;
  border-radius: 16rpx;
  padding: 26rpx;
}

.warn {
  background: #fff7ed;
  border-color: #fed7aa;
}

.row-item {
  display: grid;
  grid-template-columns: 52rpx 1fr 72rpx;
  gap: 20rpx;
  align-items: start;
  padding: 24rpx 0 0;
  border-top: 1rpx solid #edf2f7;
}

.row-item:first-child {
  padding-top: 0;
  border-top: 0;
}

.button-row {
  width: 100%;
  margin: 0;
  background: transparent;
  text-align: left;
  line-height: normal;
}

.mark {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  display: grid;
  place-items: center;
  font-size: 22rpx;
  font-weight: 800;
  background: #ecfdf5;
  color: #047857;
  line-height: 48rpx;
  text-align: center;
}

.mark.now {
  background: #eff6ff;
  color: #2563eb;
}

.row-title {
  display: block;
  font-size: 28rpx;
  color: #172033;
  font-weight: 800;
  margin-bottom: 6rpx;
}

.row-desc {
  display: block;
  color: #64748b;
  font-size: 24rpx;
  line-height: 1.45;
}

.state-label {
  color: #64748b;
  font-size: 24rpx;
  white-space: nowrap;
}

.paragraph {
  display: block;
  color: #9a3412;
  font-size: 26rpx;
  line-height: 1.5;
}
