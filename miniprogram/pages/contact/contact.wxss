/* pages/contact/contact.wxss */
.container {
  padding: 30rpx;
  background-color: #f6f6f6;
  min-height: 100vh;
}

.contact-card {
  background: #ffffff;
  border-radius: 24rpx;
  padding: 40rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.05);
}

.contact-header {
  margin-bottom: 50rpx;
  text-align: center;
}

.title {
  display: block;
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 12rpx;
}

.subtitle {
  display: block;
  font-size: 26rpx;
  color: #999;
}

.action-list {
  display: flex;
  flex-direction: column;
  gap: 30rpx;
}

.action-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: #f9f9f9;
  padding: 30rpx;
  border-radius: 16rpx;
  text-align: left;
  line-height: normal;
  border: 1px solid transparent;
  transition: all 0.3s ease;
  width: 100% !important; /* 强制宽度一致 */
  box-sizing: border-box; /* 包含内边距 */
  margin: 0 !important; /* 强制移除默认外边距 */
  font-weight: normal;
}

.action-item::after {
  border: none;
}

.action-item:active {
  background: #f0f0f0;
  border-color: #e0e0e0;
}

.content {
  display: flex;
  flex-direction: column;
}

.label {
  font-size: 30rpx;
  font-weight: 500;
  color: #333;
  margin-bottom: 8rpx;
}

.desc {
  font-size: 24rpx;
  color: #999;
}

.arrow {
  font-size: 32rpx;
  color: #ccc;
  font-weight: 300;
}
