.page {
  min-height: 100vh;
  background: #f8fafc;
}

.footer-space {
  padding-bottom: 150rpx;
}

.hero {
  background: #13315c;
  color: #fff;
  padding: 56rpx 36rpx 28rpx;
}

.topline {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 24rpx;
  margin-bottom: 32rpx;
}

.badge {
  display: inline-flex;
  align-items: center;
  gap: 14rpx;
  min-height: 56rpx;
  padding: 0 20rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.14);
  color: #d9f99d;
  font-size: 24rpx;
  font-weight: 800;
}

.dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background: #d9f99d;
}

.top-note {
  color: rgba(255, 255, 255, 0.76);
  font-size: 24rpx;
}

.hero-title {
  display: block;
  font-size: 52rpx;
  line-height: 1.24;
  font-weight: 800;
}

.hero-desc {
  display: block;
  margin-top: 20rpx;
  color: rgba(255, 255, 255, 0.82);
  font-size: 28rpx;
  line-height: 1.7;
}

.content {
  padding: 28rpx;
  display: grid;
  gap: 20rpx;
}

.section {
  background: #fff;
  border: 1rpx solid #e2e8f0;
  border-radius: 16rpx;
  padding: 26rpx;
}

.warn {
  background: #fff7ed;
  border-color: #fed7aa;
}

.section-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 20rpx;
  margin-bottom: 20rpx;
}

.section-title {
  color: #172033;
  font-size: 30rpx;
  font-weight: 800;
}

.hint {
  color: #64748b;
  font-size: 24rpx;
}

.empty-card {
  min-height: 520rpx;
  display: grid;
  place-items: center;
  text-align: center;
}

.avatar,
.avatar-img {
  width: 116rpx;
  height: 116rpx;
  border-radius: 50%;
}

.avatar {
  background: #eff6ff;
  border: 1rpx solid #d8e1ec;
  display: grid;
  place-items: center;
  color: #13315c;
  font-size: 48rpx;
  font-weight: 800;
  line-height: 116rpx;
  text-align: center;
}

.empty-title {
  display: block;
  color: #172033;
  font-size: 32rpx;
  font-weight: 800;
  margin-top: 24rpx;
}

.empty-desc,
.paragraph {
  display: block;
  color: #64748b;
  font-size: 26rpx;
  line-height: 1.5;
}

.warn .paragraph {
  color: #9a3412;
}

.primary-btn,
.secondary-btn,
.logout-btn,
.orange-btn,
.search-btn {
  border-radius: 16rpx;
  font-weight: 800;
  display: flex;
  align-items: center;
  justify-content: center;
}

.primary-btn {
  height: 104rpx;
  background: #13315c;
  color: #fff;
  font-size: 34rpx;
  box-shadow: 0 24rpx 44rpx rgba(19, 49, 92, 0.24);
}

.secondary-btn,
.logout-btn {
  height: 88rpx;
  border: 1rpx solid #d8e1ec;
  background: #fff;
  color: #13315c;
  font-size: 28rpx;
}

.orange-btn,
.search-btn {
  height: 76rpx;
  background: #f59e0b;
  color: #111827;
  font-size: 26rpx;
  white-space: nowrap;
  padding: 0 24rpx;
  margin: 0;
}

.user-card {
  display: flex;
  align-items: center;
  gap: 24rpx;
  min-height: 168rpx;
}

.avatar-btn {
  width: 116rpx;
  height: 116rpx;
  flex: 0 0 116rpx;
  padding: 0;
  margin: 0;
  border-radius: 50%;
  background: transparent;
  overflow: hidden;
  display: flex;
  align-items: center;
  justify-content: center;
  line-height: normal;
}

.avatar-btn::after {
  border: 0;
}

.avatar-img {
  display: block;
}

.user-main {
  flex: 1;
  min-width: 0;
}

.nickname-input {
  width: 100%;
  color: #172033;
  font-size: 32rpx;
  font-weight: 800;
  min-height: 56rpx;
  line-height: 56rpx;
}

.uid {
  display: block;
  margin-top: 8rpx;
  color: #64748b;
  font-size: 24rpx;
  line-height: 1.4;
  word-break: break-all;
}

.save-user-btn {
  flex: 0 0 auto;
}

.row-item {
  display: flex;
  gap: 20rpx;
  align-items: start;
  padding-top: 24rpx;
  border-top: 1rpx solid #edf2f7;
}

.row-item > view:nth-child(2) {
  flex: 1;
  min-width: 0;
}

.row-item:first-child {
  padding-top: 0;
  border-top: 0;
}

.mark {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  display: grid;
  place-items: center;
  font-size: 22rpx;
  font-weight: 800;
  background: #ecfdf5;
  color: #047857;
  line-height: 48rpx;
  text-align: center;
}

.mark.now {
  background: #eff6ff;
  color: #2563eb;
}

.row-title {
  display: block;
  font-size: 28rpx;
  color: #172033;
  font-weight: 800;
  margin-bottom: 6rpx;
}

.row-desc {
  display: block;
  color: #64748b;
  font-size: 24rpx;
  line-height: 1.45;
}

.state-label,
.status {
  color: #64748b;
  font-size: 24rpx;
  white-space: nowrap;
}

.status {
  color: #047857;
  background: #ecfdf5;
  border-radius: 999rpx;
  padding: 8rpx 12rpx;
  text-align: center;
  font-weight: 800;
  position: absolute;
  top: 0;
  right: 0;
  max-width: 96rpx;
}

.status.unpaid {
  color: #b45309;
  background: #fffbeb;
}

.date-divider {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin: 28rpx 0 14rpx;
  color: #64748b;
  font-size: 24rpx;
  font-weight: 700;
}

.date-divider::after {
  content: "";
  flex: 1;
  height: 1rpx;
  background: #edf2f7;
}

.history-card {
  padding: 22rpx 0;
  border-top: 1rpx solid #edf2f7;
}

.date-divider + .history-card {
  border-top: 0;
}

.history-top {
  display: flex;
  align-items: flex-start;
  gap: 18rpx;
  position: relative;
}

.history-main {
  flex: 1;
  min-width: 0;
  padding-right: 112rpx;
}

.history-title-row {
  display: block;
  min-width: 0;
}

.history-title {
  display: -webkit-box;
  max-width: 100%;
  color: #172033;
  font-size: 30rpx;
  line-height: 1.35;
  font-weight: 800;
  overflow: hidden;
  text-overflow: ellipsis;
  word-break: break-all;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

.history-time {
  display: block;
  margin-top: 4rpx;
  color: #64748b;
  font-size: 24rpx;
}

.history-meta,
.history-ability,
.history-summary {
  display: block;
  color: #475569;
  font-size: 24rpx;
  line-height: 1.45;
}

.history-meta {
  margin-top: 8rpx;
  color: #334155;
  font-weight: 700;
}

.history-ability {
  margin-top: 4rpx;
}

.history-summary {
  margin: 14rpx 0 0 66rpx;
  color: #64748b;
}

.history-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin: 16rpx 0 0 66rpx;
}

.history-tag {
  max-width: 100%;
  padding: 6rpx 12rpx;
  border-radius: 999rpx;
  background: #f1f5f9;
  color: #475569;
  font-size: 22rpx;
  line-height: 1.3;
}

.empty-small,
.list-footer {
  color: #64748b;
  text-align: center;
  font-size: 26rpx;
  padding: 40rpx 0 10rpx;
}
