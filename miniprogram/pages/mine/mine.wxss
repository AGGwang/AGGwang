/* pages/mine/mine.wxss */
.container {
    padding: 30rpx;
    background-color: #f8f9fa;
    min-height: 100vh;
}

.user-card {
    background: #fff;
    padding: 40rpx;
    border-radius: 16rpx;
    display: flex;
    align-items: center;
    margin-bottom: 40rpx;
    box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.05);
}

.avatar-placeholder {
    width: 100rpx;
    height: 100rpx;
    background: #eee;
    border-radius: 50%;
    text-align: center;
    line-height: 100rpx;
    font-size: 50rpx;
    margin-right: 30rpx;
}

.user-info {
    display: flex;
    flex-direction: column;
}

.nickname {
    font-size: 34rpx;
    font-weight: bold;
    color: #333;
}

.uid {
    font-size: 24rpx;
    color: #999;
    margin-top: 8rpx;
}

.section-title {
    font-size: 32rpx;
    font-weight: bold;
    color: #333;
    margin-bottom: 20rpx;
    padding-left: 10rpx;
    border-left: 8rpx solid #0052d9;
}

.record-list {
    background: #fff;
    border-radius: 16rpx;
    padding: 0 20rpx;
}

.record-item {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 30rpx 0;
    border-bottom: 1rpx solid #eee;
}

.record-item:last-child {
    border-bottom: none;
}

.record-main {
    display: flex;
    flex-direction: column;
}

.record-title {
    font-size: 30rpx;
    color: #333;
    margin-bottom: 10rpx;
}

.record-date {
    font-size: 24rpx;
    color: #999;
}

.status-tag {
    font-size: 24rpx;
    padding: 6rpx 16rpx;
    border-radius: 8rpx;
}

.status-tag.paid {
    background: #e6f7ff;
    color: #1890ff;
}

.status-tag.unpaid {
    background: #fff1f0;
    color: #ff4d4f;
}

.empty-tip {
    padding: 60rpx;
    text-align: center;
    color: #999;
    font-size: 28rpx;
}