.page {
  min-height: 100vh;
  background: #f8fafc;
}

.footer-space {
  padding-bottom: 150rpx;
}

.hero {
  background: #13315c;
  color: #fff;
  padding: 56rpx 36rpx 28rpx;
}

.topline {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 24rpx;
  margin-bottom: 32rpx;
}

.badge {
  display: inline-flex;
  align-items: center;
  gap: 14rpx;
  min-height: 56rpx;
  padding: 0 20rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.14);
  color: #d9f99d;
  font-size: 24rpx;
  font-weight: 800;
}

.dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background: #d9f99d;
}

.top-note {
  color: rgba(255, 255, 255, 0.76);
  font-size: 24rpx;
}

.hero-title {
  display: block;
  font-size: 52rpx;
  line-height: 1.24;
  font-weight: 800;
}

.hero-desc {
  display: block;
  margin-top: 20rpx;
  color: rgba(255, 255, 255, 0.82);
  font-size: 28rpx;
  line-height: 1.7;
}

.content {
  padding: 28rpx;
  display: grid;
  gap: 20rpx;
}

.section {
  background: #fff;
  border: 1rpx solid #e2e8f0;
  border-radius: 16rpx;
  padding: 26rpx;
}

.warn {
  background: #fff7ed;
  border-color: #fed7aa;
}

.section-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 20rpx;
  margin-bottom: 20rpx;
}

.section-title {
  color: #172033;
  font-size: 30rpx;
  font-weight: 800;
}

.hint {
  color: #64748b;
  font-size: 24rpx;
}

.empty-card {
  min-height: 520rpx;
  display: grid;
  place-items: center;
  text-align: center;
}

.avatar,
.avatar-img {
  width: 116rpx;
  height: 116rpx;
  border-radius: 50%;
}

.avatar {
  background: #eff6ff;
  border: 1rpx solid #d8e1ec;
  display: grid;
  place-items: center;
  color: #13315c;
  font-size: 48rpx;
  font-weight: 800;
  line-height: 116rpx;
  text-align: center;
}

.empty-title {
  display: block;
  color: #172033;
  font-size: 32rpx;
  font-weight: 800;
  margin-top: 24rpx;
}

.empty-desc,
.paragraph {
  display: block;
  color: #64748b;
  font-size: 26rpx;
  line-height: 1.5;
}

.warn .paragraph {
  color: #9a3412;
}

.primary-btn,
.secondary-btn,
.logout-btn,
.orange-btn,
.search-btn {
  border-radius: 16rpx;
  font-weight: 800;
  display: flex;
  align-items: center;
  justify-content: center;
}

.primary-btn {
  height: 104rpx;
  background: #13315c;
  color: #fff;
  font-size: 34rpx;
  box-shadow: 0 24rpx 44rpx rgba(19, 49, 92, 0.24);
}

.secondary-btn,
.logout-btn {
  height: 88rpx;
  border: 1rpx solid #d8e1ec;
  background: #fff;
  color: #13315c;
  font-size: 28rpx;
}

.orange-btn,
.search-btn {
  height: 76rpx;
  background: #f59e0b;
  color: #111827;
  font-size: 26rpx;
  white-space: nowrap;
  padding: 0 24rpx;
  margin: 0;
}

.user-card {
  display: flex;
  align-items: center;
  gap: 24rpx;
  min-height: 168rpx;
}

.avatar-btn {
  width: 116rpx;
  height: 116rpx;
  flex: 0 0 116rpx;
  padding: 0;
  margin: 0;
  border-radius: 50%;
  background: transparent;
  overflow: hidden;
  display: flex;
  align-items: center;
  justify-content: center;
  line-height: normal;
}

.avatar-btn::after {
  border: 0;
}

.avatar-img {
  display: block;
}

.user-main {
  flex: 1;
  min-width: 0;
}

.nickname-input {
  width: 100%;
  color: #172033;
  font-size: 32rpx;
  font-weight: 800;
  min-height: 56rpx;
  line-height: 56rpx;
}

.uid {
  display: block;
  margin-top: 8rpx;
  color: #64748b;
  font-size: 24rpx;
  line-height: 1.4;
  word-break: break-all;
}

.save-user-btn {
  flex: 0 0 auto;
}

.row-item {
  display: flex;
  gap: 20rpx;
  align-items: start;
  padding-top: 24rpx;
  border-top: 1rpx solid #edf2f7;
}

.row-item > view:nth-child(2) {
  flex: 1;
  min-width: 0;
}

.row-item:first-child {
  padding-top: 0;
  border-top: 0;
}

.mark {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  display: grid;
  place-items: center;
  font-size: 22rpx;
  font-weight: 800;
  background: #ecfdf5;
  color: #047857;
  line-height: 48rpx;
  text-align: center;
}

.mark.now {
  background: #eff6ff;
  color: #2563eb;
}

.row-title {
  display: block;
  font-size: 28rpx;
  color: #172033;
  font-weight: 800;
  margin-bottom: 6rpx;
}

.row-desc {
  display: block;
  color: #64748b;
  font-size: 24rpx;
  line-height: 1.45;
}

.state-label,
.status {
  color: #64748b;
  font-size: 24rpx;
  white-space: nowrap;
}

.status {
  color: #047857;
  background: #ecfdf5;
  border-radius: 999rpx;
  padding: 8rpx 12rpx;
  text-align: center;
  font-weight: 800;
}

.status.unpaid {
  color: #b45309;
  background: #fffbeb;
}

.search-row {
  display: grid;
  grid-template-columns: 1fr auto;
  gap: 16rpx;
  margin-bottom: 20rpx;
}

.search-input {
  min-height: 76rpx;
  border: 1rpx solid #d8e1ec;
  border-radius: 16rpx;
  background: #f8fafc;
  padding: 0 20rpx;
  color: #334155;
  font-size: 26rpx;
}

.record {
  align-items: flex-start;
}

.empty-small,
.list-footer {
  color: #64748b;
  text-align: center;
  font-size: 26rpx;
  padding: 40rpx 0 10rpx;
}
