/* pages/mine/mine.wxss */
.container {
    padding: 30rpx;
    background-color: #f8f9fa;
    min-height: 100vh;
    /* 重置 app.wxss 的影响 */
    display: block;
    height: auto;
    box-sizing: border-box;
}

/* 登录页样式 */
.login-container {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding-top: 160rpx;
}

.logo-box {
    display: flex;
    flex-direction: column;
    align-items: center;
    margin-bottom: 120rpx;
}

.app-logo {
    width: 160rpx;
    height: 160rpx;
    margin-bottom: 30rpx;
    border-radius: 30rpx;
    box-shadow: 0 8rpx 24rpx rgba(0, 82, 217, 0.15);
}

.app-name {
    font-size: 40rpx;
    font-weight: bold;
    color: #333;
}

.login-btn {
    width: 80% !important;
    background: #07c160;
    color: #fff;
    border-radius: 50rpx;
    font-size: 32rpx;
    font-weight: bold;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 24rpx 0;
    box-shadow: 0 8rpx 20rpx rgba(7, 193, 96, 0.3);
    margin-bottom: 30rpx;
}

.login-btn:active {
    background: #06ad56;
}

.login-tip {
    font-size: 24rpx;
    color: #999;
}

/* 用户卡片样式 */
.user-card {
    background: #fff;
    padding: 40rpx 30rpx;
    border-radius: 24rpx;
    display: flex;
    align-items: center;
    margin-bottom: 50rpx;
    box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.04);
    position: relative;
}

.avatar-box {
    margin-right: 30rpx;
    position: relative;
}

.avatar-btn {
    padding: 0;
    margin: 0;
    width: 140rpx !important;
    height: 140rpx !important;
    border-radius: 50%;
    background: none;
    position: relative;
    overflow: visible;
}

.avatar-btn::after {
    border: none;
}

.avatar-img {
    width: 140rpx;
    height: 140rpx;
    border-radius: 50%;
    border: 4rpx solid #fff;
    box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.1);
}

.avatar-placeholder {
    width: 140rpx;
    height: 140rpx;
    background: #f0f2f5;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    border: 4rpx solid #fff;
    box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.05);
}

.camera-icon {
    position: absolute;
    bottom: 0;
    right: 0;
    background: rgba(0, 0, 0, 0.5);
    color: #fff;
    font-size: 20rpx;
    width: 40rpx;
    height: 40rpx;
    border-radius: 50%;
    text-align: center;
    line-height: 40rpx;
    backdrop-filter: blur(4px);
}

.user-info {
    display: flex;
    flex-direction: column;
    flex: 1;
}

.nickname-input {
    font-size: 36rpx;
    font-weight: bold;
    color: #333;
    margin-bottom: 10rpx;
    height: 60rpx;
    min-height: 60rpx;
    border-bottom: 1rpx dashed transparent;
    transition: border-color 0.3s;
}

.nickname-input:focus {
    border-bottom-color: #0052d9;
}

.uid {
    font-size: 22rpx;
    color: #999;
    background: #f5f5f5;
    padding: 4rpx 12rpx;
    border-radius: 8rpx;
    display: inline-block;
    align-self: flex-start;
}

.save-hint {
    font-size: 20rpx;
    color: #ff4d4f;
    margin-top: 10rpx;
    animation: bounce 1s infinite;
}

@keyframes bounce {

    0%,
    100% {
        transform: translateX(0);
    }

    50% {
        transform: translateX(6rpx);
    }
}

.action-box {
    margin-left: 20rpx;
}

.save-btn {
    background: #0052d9 !important;
    color: #fff !important;
    font-size: 24rpx;
    padding: 8rpx 24rpx;
    border-radius: 30rpx;
    font-weight: normal;
}

/* 菜单列表样式 */
.menu-list {
    background: #fff;
    border-radius: 24rpx;
    padding: 0 30rpx;
    margin-bottom: 50rpx;
    box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.02);
}

.menu-item {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 32rpx 0;
    width: 100%;
}

.menu-item:active {
    opacity: 0.7;
}

.menu-left {
    display: flex;
    align-items: center;
}

.menu-text {
    font-size: 30rpx;
    color: #333;
    font-weight: 500;
}

.divider-line {
    height: 1rpx;
    background-color: #f0f0f0;
    width: 100%;
}

.section-title {
    font-size: 34rpx;
    font-weight: bold;
    color: #333;
    margin-bottom: 24rpx;
    padding-left: 16rpx;
    border-left: 8rpx solid #0052d9;
    display: flex;
    align-items: center;
}

.record-list {
    background: #fff;
    border-radius: 24rpx;
    padding: 10rpx 30rpx;
    box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.02);
    min-height: 200rpx;
}

.record-item {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 32rpx 0;
    border-bottom: 1rpx solid #f0f0f0;
}

.record-item:last-child {
    border-bottom: none;
}

.record-main {
    display: flex;
    flex-direction: column;
}

.record-title {
    font-size: 30rpx;
    color: #333;
    font-weight: 500;
    margin-bottom: 12rpx;
}

.record-date {
    font-size: 24rpx;
    color: #bbb;
}

.status-tag {
    font-size: 22rpx;
    padding: 8rpx 20rpx;
    border-radius: 30rpx;
    font-weight: 500;
}

.status-tag.paid {
    background: #e6f7ff;
    color: #0052d9;
}

.status-tag.unpaid {
    background: #fff1f0;
    color: #ff4d4f;
}

.empty-tip {
    padding: 80rpx 0;
    text-align: center;
    color: #999;
    font-size: 28rpx;
    display: flex;
    flex-direction: column;
    align-items: center;
}

.empty-tip::before {
    content: '📭';
    font-size: 60rpx;
    margin-bottom: 20rpx;
    opacity: 0.5;
}

.logout-area {
    margin-top: 60rpx;
    text-align: center;
    padding-bottom: 40rpx;
}

.logout-text {
    font-size: 28rpx;
    color: #999;
    text-decoration: underline;
}