<view class="page footer-space">
  <view class="hero compact">
    <view class="topline">
      <view class="badge"><view class="dot"></view><text>我的</text></view>
      <text class="top-note">{{isLogged ? '登录态' : '未登录'}}</text>
    </view>
    <text class="hero-title">{{isLogged ? '个人中心与历史记录' : '登录后同步报告和订单'}}</text>
    <text class="hero-desc">{{isLogged ? '将订单、反馈、历史报告统一为学习决策档案。' : '登录后查看历史记录、订单和已解锁报告。'}}</text>
  </view>

  <view class="content" wx:if="{{!isLogged}}">
    <view class="section empty-card">
      <view class="avatar">AI</view>
      <text class="empty-title">AI 选科与职业规划</text>
      <text class="empty-desc">登录后查看历史记录、订单和已解锁报告。</text>
    </view>
    <button class="primary-btn" bindtap="handleLogin">微信一键登录</button>
    <view class="section warn">
      <text class="paragraph">仅用于同步历史报告和支付订单，不会公开你的个人信息。</text>
    </view>
  </view>

  <view class="content" wx:else>
    <view class="section user-card">
      <button class="avatar-btn" open-type="chooseAvatar" bind:chooseavatar="onChooseAvatar">
        <image wx:if="{{userInfo.avatarUrl}}" class="avatar-img" src="{{userInfo.avatarUrl}}" mode="aspectFill"></image>
        <view wx:else class="avatar">P</view>
      </button>
      <view class="user-main">
        <input type="nickname" class="nickname-input" placeholder="点击输入昵称" value="{{userInfo.nickName}}" bind:change="onNicknameChange" bind:blur="onNicknameBlur" />
        <text class="uid" bindtap="copyOpenId">ID: {{openid || '...'}} (点击复制)</text>
      </view>
      <button class="orange-btn save-user-btn" wx:if="{{needSave}}" bindtap="saveUserInfo">保存</button>
    </view>

    <view class="section">
      <view class="row-item" bindtap="goToOrder">
        <view class="mark">¥</view>
        <view>
          <text class="row-title">我的订单</text>
          <text class="row-desc">查看已支付与退款状态。</text>
        </view>
        <text class="state-label">进入</text>
      </view>
      <view class="row-item" bindtap="goToContact">
        <view class="mark now">?</view>
        <view>
          <text class="row-title">联系与反馈</text>
          <text class="row-desc">在线客服、问题反馈、商务咨询。</text>
        </view>
        <text class="state-label">进入</text>
      </view>
    </view>

    <view class="section">
      <view class="section-head">
        <text class="section-title">历史记录</text>
        <text class="hint">{{historyHint}}</text>
      </view>

      <view wx:if="{{historyRecords.length === 0 && !historyLoading}}" class="empty-small">暂无历史记录</view>
      <block wx:else>
        <block wx:for="{{historyRecords}}" wx:key="_id">
          <view class="date-divider" wx:if="{{item.showDateGroup}}">
            <text>{{item.dateGroup}}</text>
          </view>
          <view class="history-card" bindtap="goToHistoryDetail" data-record-type="{{item.recordType}}" data-source-id="{{item.sourceId}}">
            <view class="history-top">
              <view class="mark">职</view>
              <view class="history-main">
                <view class="history-title-row">
                  <text class="history-title">{{item.title}}</text>
                  <text class="history-time">{{item.timeShort}}</text>
                </view>
                <text class="history-meta">{{item.metaLine}}</text>
                <text class="history-ability" wx:if="{{item.abilityLine}}">{{item.abilityLine}}</text>
              </view>
              <text class="status {{item.isPaid ? '' : 'unpaid'}}">{{item.statusText}}</text>
            </view>
            <text class="history-summary" wx:if="{{item.summarySnippet}}">{{item.summarySnippet}}</text>
            <view class="history-tags" wx:if="{{item.inputTags.length}}">
              <text class="history-tag" wx:for="{{item.inputTags}}" wx:for-item="tag" wx:key="*this">{{tag}}</text>
            </view>
          </view>
        </block>
      </block>

      <view class="list-footer" wx:if="{{historyLoading}}">加载中...</view>
      <view class="list-footer" wx:elif="{{!historyHasMore && historyRecords.length > 0}}">没有更多了</view>
      <button class="secondary-btn" wx:elif="{{historyHasMore && historyRecords.length > 0}}" bindtap="loadMoreHistoryRecords">加载更多</button>
    </view>

    <button class="logout-btn" bindtap="handleLogout">退出登录</button>
  </view>
</view>
