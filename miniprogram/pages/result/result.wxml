<!-- pages/result/result.wxml -->
<view class="container">
    <!-- 生成中状态 -->
    <view class="generating-card" wx:if="{{generating}}">
        <view class="gen-header">
            <text class="gen-title">AI 正在生成 {{record.targetCareer}} 职业规划</text>
            <text class="gen-subtitle">实时输出 (仅展示部分内容，更多需解锁)</text>
        </view>
        <view class="progress-bar">
            <view class="progress-inner"></view>
        </view>
        <!-- 生成时也展示部分预览内容 -->
        <scroll-view class="content-scroll generating-preview" scroll-y="true">
            <text class="content-text">{{displayText}}</text>
        </scroll-view>
    </view>
    <!-- 结果展示卡片 -->
    <block wx:else>
        <view class="report-card">
            <view class="report-header">
                <text class="career-title">{{record.targetCareer}} 职业规划</text>
                <view class="score-box">
                    <text class="score-label">当前分数:</text>
                    <text class="score-val">{{record.score}}</text>
                </view>
            </view>
            <scroll-view class="content-scroll" scroll-y="true">
                <text class="content-text">{{displayText}}</text>
                <!-- 未付费时显示占位内容以撑开高度，确保模糊效果覆盖下方 -->
                <block wx:if="{{!isPaid}}">
                    <view class="blur-placeholder">
                        <text>以下内容需解锁查看...</text>
                        <text>详细学习路径规划...</text>
                        <text>未来职业前景分析...</text>
                        <text>专业选科建议...</text>
                        <text>...</text>
                        <text>更多深度分析...</text>
                        <text>行业薪资水平...</text>
                        <text>就业竞争分析...</text>
                    </view>
                </block>
            </scroll-view>
            <!-- 模糊遮罩 (置于 scroll-view 外部或作为覆盖层) -->
            <view class="gauss-mask" wx:if="{{!isPaid}}"></view>
        </view>
    </block>
    <!-- 底部付费栏 (始终固定) -->
    <view class="pay-footer" wx:if="{{!isPaid && !generating}}">
        <view class="pay-info">
            <text class="pay-tip">已为你实时展示部分内容，解锁查看完整 3000字+ 深度规划报告</text>
            <view class="price-box">
                <text class="original-price">¥{{record.originalPrice}}</text>
                <text class="current-price">¥{{record.price}}</text>
            </view>
        </view>
        <button class="unlock-btn" bindtap="handlePay">立即解锁</button>
        <button class="dev-btn" bindtap="devUnlock">[开发测试] 模拟支付成功</button>
    </view>
</view>
