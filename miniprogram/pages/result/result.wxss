/* pages/result/result.wxss */
.container {
    padding: 30rpx;
    padding-bottom: 240rpx;
    /* 为底部固定栏留出空间 */
    background-color: #f8f9fa;
    min-height: 100vh;
    box-sizing: border-box;
    display: flex;
    flex-direction: column;
}

/* 生成态卡片 */
.generating-card {
    background: #fff;
    padding: 40rpx;
    border-radius: 24rpx;
    box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.05);
    margin-bottom: 40rpx;
    animation: fadeIn 0.5s ease;
    display: flex;
    flex-direction: column;
    flex: 1;
    /* 撑开高度 */
    min-height: 60vh;
}

.generating-preview {
    margin-top: 30rpx;
    flex: 1;
    border-top: 1rpx dashed #eee;
    padding-top: 20rpx;
}

.gen-header {
    margin-bottom: 30rpx;
}

.gen-title {
    font-size: 36rpx;
    font-weight: bold;
    color: #333;
    display: block;
    margin-bottom: 12rpx;
}

.gen-subtitle {
    font-size: 26rpx;
    color: #999;
}

.progress-bar {
    height: 8rpx;
    background: #f0f0f0;
    border-radius: 4rpx;
    overflow: hidden;
    position: relative;
}

.progress-inner {
    height: 100%;
    background: #0052d9;
    width: 30%;
    border-radius: 4rpx;
    position: absolute;
    left: 0;
    top: 0;
    animation: progressLoop 2s infinite ease-in-out;
}

@keyframes progressLoop {
    0% {
        left: -30%;
        width: 30%;
    }

    50% {
        left: 30%;
        width: 60%;
    }

    100% {
        left: 100%;
        width: 30%;
    }
}

@keyframes fadeIn {
    from {
        opacity: 0;
        transform: translateY(20rpx);
    }

    to {
        opacity: 1;
        transform: translateY(0);
    }
}

/* 报告卡片 */
.report-card {
    background: #fff;
    border-radius: 24rpx;
    box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.03);
    padding: 40rpx 30rpx;
    flex: 1;
    display: flex;
    flex-direction: column;
    position: relative;
    overflow: hidden;
    /* 确保遮罩不溢出圆角 */
}

.report-header {
    margin-bottom: 30rpx;
    border-bottom: 1rpx solid #f0f0f0;
    padding-bottom: 24rpx;
}

.career-title {
    font-size: 40rpx;
    font-weight: 800;
    color: #333;
    display: block;
    margin-bottom: 20rpx;
}

.score-box {
    background: #f5f5f5;
    padding: 12rpx 20rpx;
    border-radius: 8rpx;
    display: inline-block;
}

.score-label {
    font-size: 24rpx;
    color: #666;
    margin-right: 12rpx;
}

.score-val {
    font-size: 26rpx;
    color: #333;
    font-family: monospace;
}

.content-scroll {
    flex: 1;
    /* 确保有足够高度显示模糊遮罩 */
    min-height: 60vh;
    position: relative;
}

.content-text {
    font-size: 30rpx;
    line-height: 1.8;
    color: #333;
    white-space: pre-wrap;
    word-break: break-word;
    overflow-wrap: anywhere;
    display: block;
}

/* 模糊占位与遮罩 */
.blur-placeholder {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    padding-top: 20rpx;
    opacity: 0.4;
    filter: blur(3px);
    pointer-events: none;
    user-select: none;
}

.blur-placeholder text {
    font-size: 30rpx;
    line-height: 2;
    color: #444;
    margin-bottom: 10rpx;
    width: 100%;
}

.gauss-mask {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    height: 50%;
    /* 覆盖下半部分 */
    min-height: 500rpx;
    backdrop-filter: blur(10px);
    background: linear-gradient(to bottom, rgba(255, 255, 255, 0) 0%, rgba(255, 255, 255, 0.8) 30%, rgba(255, 255, 255, 1) 80%);
    z-index: 10;
    pointer-events: none;
}

/* 底部付费栏 */
.pay-footer {
    position: fixed;
    bottom: 0;
    left: 0;
    right: 0;
    background: #fff;
    padding: 30rpx 40rpx;
    padding-bottom: calc(30rpx + env(safe-area-inset-bottom));
    box-shadow: 0 -4rpx 24rpx rgba(0, 0, 0, 0.08);
    z-index: 100;
    border-top-left-radius: 24rpx;
    border-top-right-radius: 24rpx;
    display: flex;
    flex-direction: column;
    align-items: center;
    animation: slideUp 0.4s ease-out;
}

@keyframes slideUp {
    from {
        transform: translateY(100%);
    }

    to {
        transform: translateY(0);
    }
}

.pay-info {
    width: 100%;
    text-align: center;
    margin-bottom: 30rpx;
}

.pay-tip {
    font-size: 26rpx;
    color: #666;
    margin-bottom: 16rpx;
    display: block;
}

.price-box {
    display: flex;
    align-items: baseline;
    justify-content: center;
}

.original-price {
    font-size: 28rpx;
    color: #999;
    text-decoration: line-through;
    margin-right: 20rpx;
}

.current-price {
    font-size: 48rpx;
    font-weight: bold;
    color: #ff4d4f;
}

.unlock-btn {
    width: 100% !important;
    background: linear-gradient(135deg, #ff4d4f, #ff7875);
    color: #fff;
    font-size: 34rpx;
    font-weight: bold;
    border-radius: 50rpx;
    height: 96rpx;
    line-height: 96rpx;
    box-shadow: 0 8rpx 20rpx rgba(255, 77, 79, 0.3);
    margin-bottom: 20rpx;
}

.unlock-btn:active {
    transform: scale(0.98);
}

.dev-btn {
    background: #f5f5f5;
    color: #999;
    font-size: 24rpx;
    padding: 10rpx 30rpx;
    border-radius: 10rpx;
}