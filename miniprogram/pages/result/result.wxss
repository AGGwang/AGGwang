.page {
  min-height: 100vh;
  background: #f8fafc;
}

.footer-space {
  padding-bottom: 180rpx;
}

.hero {
  background: #13315c;
  color: #fff;
  padding: 56rpx 36rpx 36rpx;
}

.compact {
  padding-bottom: 28rpx;
}

.topline {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 24rpx;
  margin-bottom: 32rpx;
}

.badge {
  display: inline-flex;
  align-items: center;
  gap: 14rpx;
  min-height: 56rpx;
  padding: 0 20rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.14);
  color: #d9f99d;
  font-size: 24rpx;
  font-weight: 800;
}

.dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background: #d9f99d;
}

.top-note {
  color: rgba(255, 255, 255, 0.76);
  font-size: 24rpx;
}

.hero-title {
  display: block;
  font-size: 52rpx;
  line-height: 1.24;
  font-weight: 800;
}

.hero-desc {
  display: block;
  margin-top: 20rpx;
  color: rgba(255, 255, 255, 0.82);
  font-size: 28rpx;
  line-height: 1.7;
}

.content {
  padding: 28rpx;
  display: grid;
  gap: 20rpx;
}

.section,
.metric {
  background: #fff;
  border: 1rpx solid #e2e8f0;
  border-radius: 16rpx;
  padding: 24rpx;
}

.warn {
  background: #fff7ed;
  border-color: #fed7aa;
}

.dark {
  background: #111827;
  border-color: #111827;
}

.section-head,
.progress-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 20rpx;
  margin-bottom: 20rpx;
}

.section-title {
  color: #172033;
  font-size: 30rpx;
  font-weight: 800;
}

.hint,
.progress-num {
  color: #64748b;
  font-size: 24rpx;
}

.dark-title {
  color: #fff;
}

.dark-hint {
  color: #cbd5e1;
}

.progress {
  height: 16rpx;
  border-radius: 999rpx;
  background: #e2e8f0;
  overflow: hidden;
}

.progress view {
  width: 68%;
  height: 100%;
  background: #2563eb;
  border-radius: inherit;
  animation: loading 1.6s ease-in-out infinite alternate;
}

@keyframes loading {
  from { width: 42%; }
  to { width: 78%; }
}

.loading-step,
.row-item {
  display: grid;
  grid-template-columns: 52rpx 1fr 72rpx;
  gap: 20rpx;
  align-items: start;
  padding-top: 24rpx;
  border-top: 1rpx solid #edf2f7;
}

.loading-step:first-child {
  padding-top: 0;
  border-top: 0;
}

.mark {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  display: grid;
  place-items: center;
  font-size: 22rpx;
  font-weight: 800;
  background: #ecfdf5;
  color: #047857;
  text-align: center;
  line-height: 48rpx;
}

.mark.now {
  background: #eff6ff;
  color: #2563eb;
}

.row-title {
  display: block;
  font-size: 28rpx;
  color: #172033;
  font-weight: 800;
  margin-bottom: 6rpx;
}

.row-desc {
  display: block;
  color: #64748b;
  font-size: 24rpx;
  line-height: 1.45;
}

.state-label {
  color: #64748b;
  font-size: 24rpx;
  white-space: nowrap;
}

.paragraph,
.report-text {
  display: block;
  color: #475569;
  font-size: 26rpx;
  line-height: 1.7;
  white-space: pre-wrap;
  word-break: break-word;
}

.warn .paragraph {
  color: #9a3412;
}

.summary {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 16rpx;
}

.metric {
  min-height: 144rpx;
  padding: 20rpx;
}

.metric text:first-child,
.income-card text:first-child {
  display: block;
  color: #64748b;
  font-size: 22rpx;
  margin-bottom: 14rpx;
}

.metric-value,
.income-value {
  display: block;
  color: #172033;
  font-size: 30rpx;
  line-height: 1.25;
  font-weight: 800;
}

.verdict {
  background: #f8fafc;
  border: 1rpx solid #e2e8f0;
  border-radius: 16rpx;
  padding: 22rpx;
  margin-bottom: 20rpx;
}

.verdict-title {
  display: block;
  font-size: 30rpx;
  color: #172033;
  font-weight: 800;
  line-height: 1.4;
  margin-bottom: 12rpx;
}

.verdict-desc {
  display: block;
  color: #475569;
  font-size: 26rpx;
  line-height: 1.55;
}

.score-list {
  display: grid;
  gap: 16rpx;
}

.score-row {
  display: grid;
  grid-template-columns: 148rpx 1fr 60rpx;
  gap: 16rpx;
  align-items: center;
  color: #475569;
  font-size: 24rpx;
  font-weight: 800;
}

.score-reason {
  grid-column: 1 / -1;
  color: #64748b;
  font-size: 23rpx;
  line-height: 1.45;
  font-weight: 500;
}

.score-track,
.bar {
  height: 14rpx;
  border-radius: 999rpx;
  background: #e2e8f0;
  overflow: hidden;
}

.score-track view,
.bar view {
  height: 100%;
  border-radius: inherit;
  background: #2563eb;
}

.career-list,
.job-detail,
.career-roadmap,
.strategy,
.avoid-list {
  display: grid;
  gap: 18rpx;
}

.career {
  display: grid;
  grid-template-columns: 76rpx 1fr;
  gap: 18rpx;
  padding-top: 18rpx;
  border-top: 1rpx solid #edf2f7;
}

.career:first-child {
  padding-top: 0;
  border-top: 0;
}

.rank {
  width: 72rpx;
  height: 72rpx;
  border-radius: 16rpx;
  display: grid;
  place-items: center;
  background: #eff6ff;
  color: #2563eb;
  font-size: 28rpx;
  font-weight: 800;
  text-align: center;
  line-height: 72rpx;
}

.career-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 8rpx;
}

.career-name {
  color: #172033;
  font-size: 28rpx;
  font-weight: 800;
  line-height: 1.35;
}

.match {
  flex: none;
  color: #047857;
  background: #ecfdf5;
  border-radius: 999rpx;
  padding: 8rpx 16rpx;
  font-size: 24rpx;
  font-weight: 800;
}

.career-desc {
  display: block;
  color: #64748b;
  font-size: 24rpx;
  line-height: 1.5;
  margin-bottom: 16rpx;
}

.career-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-bottom: 14rpx;
}

.career-detail-block {
  display: grid;
  gap: 10rpx;
  padding: 16rpx 0;
  border-top: 1rpx solid #edf2f7;
}

.career-detail-title {
  color: #13315c;
  font-size: 24rpx;
  font-weight: 800;
}

.mini-list {
  display: grid;
  gap: 8rpx;
}

.mini-list text,
.career-path,
.career-income-note {
  display: block;
  color: #475569;
  font-size: 24rpx;
  line-height: 1.5;
}

.career-income {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 12rpx;
}

.career-income view {
  min-height: 104rpx;
  border-radius: 14rpx;
  background: #f8fafc;
  border: 1rpx solid #e2e8f0;
  padding: 14rpx;
  box-sizing: border-box;
}

.career-income text:first-child {
  display: block;
  color: #64748b;
  font-size: 21rpx;
  margin-bottom: 8rpx;
}

.career-income text:last-child {
  display: block;
  color: #172033;
  font-size: 24rpx;
  line-height: 1.3;
  font-weight: 800;
}

.career-caution {
  display: block;
  color: #9a3412;
  font-size: 24rpx;
  line-height: 1.45;
  padding-top: 14rpx;
  border-top: 1rpx solid #fed7aa;
  margin-bottom: 16rpx;
}

.major-groups {
  display: grid;
  gap: 18rpx;
}

.major-group {
  display: grid;
  gap: 12rpx;
  padding-top: 18rpx;
  border-top: 1rpx solid #edf2f7;
}

.major-group:first-child {
  padding-top: 0;
  border-top: 0;
}

.major-title {
  color: #13315c;
  font-size: 26rpx;
  font-weight: 800;
}

.tags {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
}

.tag {
  min-height: 54rpx;
  border-radius: 999rpx;
  padding: 0 18rpx;
  display: inline-flex;
  align-items: center;
  border: 1rpx solid #d8e1ec;
  background: #f8fafc;
  color: #475569;
  font-size: 24rpx;
  font-weight: 800;
}

.job-row,
.strategy-row {
  display: grid;
  grid-template-columns: 144rpx 1fr;
  gap: 20rpx;
  padding: 20rpx;
  border-radius: 16rpx;
  background: #f8fafc;
  border: 1rpx solid #e2e8f0;
}

.job-label {
  color: #13315c;
  font-size: 26rpx;
  font-weight: 800;
  line-height: 1.45;
}

.job-text,
.strategy-row text:last-child {
  color: #475569;
  font-size: 26rpx;
  line-height: 1.55;
}

.income-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 16rpx;
}

.income-card {
  min-height: 148rpx;
  border: 1rpx solid #e2e8f0;
  border-radius: 16rpx;
  background: #f8fafc;
  padding: 20rpx;
}

.income-note {
  display: block;
  color: #64748b;
  font-size: 22rpx;
  line-height: 1.4;
  margin-top: 10rpx;
}

.roadmap-step {
  display: grid;
  grid-template-columns: 108rpx 1fr;
  gap: 20rpx;
  padding-top: 18rpx;
  border-top: 1rpx solid #edf2f7;
}

.roadmap-step:first-child {
  padding-top: 0;
  border-top: 0;
}

.stage,
.strategy-label {
  height: 56rpx;
  border-radius: 16rpx;
  background: #eff6ff;
  color: #2563eb;
  display: grid;
  place-items: center;
  font-size: 24rpx;
  font-weight: 800;
  text-align: center;
  line-height: 56rpx;
}

.roadmap-text {
  color: #475569;
  font-size: 26rpx;
  line-height: 1.55;
}

.strategy-label {
  color: #fff;
}

.rush {
  background: #2563eb;
}

.stable {
  background: #059669;
}

.safe {
  background: #d97706;
}

.avoid-item {
  display: grid;
  grid-template-columns: 44rpx 1fr;
  gap: 16rpx;
  color: #9a3412;
  font-size: 26rpx;
  line-height: 1.5;
}

.avoid-item text:first-child {
  width: 36rpx;
  height: 36rpx;
  border-radius: 50%;
  background: #fed7aa;
  color: #9a3412;
  display: grid;
  place-items: center;
  font-size: 24rpx;
  font-weight: 800;
  text-align: center;
  line-height: 36rpx;
}

.dark-text {
  display: block;
  color: #d1d5db;
  font-size: 26rpx;
  line-height: 1.55;
  margin-bottom: 20rpx;
}

.orange-btn {
  height: 80rpx;
  border-radius: 16rpx;
  padding: 0 24rpx;
  background: #f59e0b;
  color: #111827;
  font-size: 26rpx;
  font-weight: 800;
  white-space: nowrap;
  display: flex;
  align-items: center;
  justify-content: center;
}

.inline {
  width: 220rpx;
  margin: 0;
}

.bottom {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  background: #111827;
  color: #fff;
  padding: 24rpx 28rpx calc(32rpx + env(safe-area-inset-bottom));
  display: grid;
  grid-template-columns: 1fr auto;
  gap: 20rpx;
  align-items: center;
  z-index: 20;
}

.bottom-title {
  display: block;
  font-size: 28rpx;
  font-weight: 800;
  margin-bottom: 8rpx;
}

.bottom-desc {
  display: block;
  color: #d1d5db;
  font-size: 24rpx;
  line-height: 1.4;
}
