/* pages/result/result.wxss */
.container {
  padding: 30rpx;
  background-color: #f8f9fa;
  min-height: 100vh;
  overflow-x: hidden;
  padding-bottom: 220rpx;
}

.report-card {
  background: #fff;
  border-radius: 20rpx;
  padding: 40rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.05);
  position: relative;
  overflow: hidden;
  min-height: 80vh;
}

.report-header {
  border-bottom: 1rpx solid #eee;
  padding-bottom: 30rpx;
  margin-bottom: 30rpx;
}

.career-title {
  font-size: 40rpx;
  font-weight: bold;
  color: #333;
  display: block;
}

.score-tag {
  font-size: 26rpx;
  color: #666;
  background: #f0f0f0;
  padding: 6rpx 16rpx;
  border-radius: 8rpx;
  margin-top: 16rpx;
  display: inline-block;
}

.report-content {
  font-size: 30rpx;
  line-height: 1.8;
  color: #444;
  white-space: pre-wrap;
}

.content-scroll {
  flex: 1;
  overflow-y: auto;
  padding-right: 8rpx;
  position: relative;
  /* 确保有足够高度显示模糊遮罩 */
  min-height: 60vh;
}

.content-text {
  display: block;
  width: 100%;
  word-break: break-word;
  overflow-wrap: anywhere;
  white-space: pre-wrap;
}

.blur-placeholder {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  padding-top: 40rpx;
  opacity: 0.3;
  filter: blur(2px);
  pointer-events: none;
}

.blur-placeholder text {
  font-size: 30rpx;
  line-height: 2;
  color: #444;
  margin-bottom: 10rpx;
  width: 100%;
}

.gauss-mask {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  height: 40%;
  min-height: 300rpx;
  backdrop-filter: blur(12px);
  background: linear-gradient(to bottom, rgba(255, 255, 255, 0), rgba(255, 255, 255, 0.95) 40%, #fff);
  z-index: 10;
}

.pay-footer {
  position: fixed;
  left: 0;
  right: 0;
  bottom: env(safe-area-inset-bottom);
  padding: 16rpx 30rpx calc(16rpx + env(safe-area-inset-bottom));
  background: rgba(248, 249, 250, 0.95);
  backdrop-filter: blur(6px);
  z-index: 99;
}

.footer-box {
  background: #fff;
  border-radius: 16rpx;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.06);
  padding: 20rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.footer-text {
  font-size: 26rpx;
  color: #666;
}

.footer-price {
  font-size: 36rpx;
  color: #ff4d4f;
  font-weight: bold;
}

.footer-btn {
  background: linear-gradient(135deg, #ff7875, #ff4d4f);
  color: #fff;
  border-radius: 50rpx;
  font-weight: bold;
  padding: 0 32rpx;
  height: 72rpx;
  line-height: 72rpx;
}

.lock-section {
  margin-top: 24rpx;
  background: #fff;
  border-radius: 16rpx;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.06);
  padding: 24rpx 24rpx 36rpx;
  text-align: center;
}

.lock-tip {
  font-size: 28rpx;
  color: #666;
  margin-bottom: 20rpx;
}

.price-box {
  margin: 8rpx 0 30rpx;
}

.original-price {
  font-size: 28rpx;
  color: #999;
  text-decoration: line-through;
  margin-right: 20rpx;
}

.current-price {
  font-size: 48rpx;
  color: #ff4d4f;
  font-weight: bold;
}

.unlock-btn {
  background: linear-gradient(135deg, #ff7875, #ff4d4f);
  color: white;
  border-radius: 50rpx;
  font-weight: bold;
  box-shadow: 0 8rpx 20rpx rgba(255, 77, 79, 0.3);
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
}

.loading {
  text-align: center;
  margin-top: 100rpx;
  color: #999;
}

.dev-btn {
  margin-top: 20rpx;
  font-size: 24rpx;
  background: #eee;
  color: #666;
}

/* 生成态样式 */
.generating-card {
  background: #fff;
  border-radius: 20rpx;
  padding: 40rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.05);
}

.gen-header {
  margin-bottom: 20rpx;
}

.gen-title {
  font-size: 34rpx;
  font-weight: bold;
  color: #333;
  display: block;
}

.gen-sub {
  font-size: 24rpx;
  color: #999;
}

.gen-content {
  font-size: 30rpx;
  line-height: 1.8;
  color: #444;
  white-space: pre-wrap;
  min-height: 300rpx;
}

.progress-bar {
  height: 12rpx;
  background: #f0f0f0;
  border-radius: 12rpx;
  overflow: hidden;
  margin-top: 20rpx;
}

.progress-inner {
  width: 40%;
  height: 100%;
  background: linear-gradient(135deg, #0052d9, #003bb3);
  animation: progressAnim 1.8s infinite ease-in-out;
}

@keyframes progressAnim {
  0% {
    width: 20%;
  }

  50% {
    width: 80%;
  }

  100% {
    width: 20%;
  }
}