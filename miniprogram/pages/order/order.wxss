.page {
  min-height: 100vh;
  background: #f8fafc;
}

.hero {
  background: #13315c;
  color: #fff;
  padding: 56rpx 36rpx 28rpx;
}

.topline {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 24rpx;
  margin-bottom: 32rpx;
}

.badge {
  display: inline-flex;
  align-items: center;
  gap: 14rpx;
  min-height: 56rpx;
  padding: 0 20rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.14);
  color: #d9f99d;
  font-size: 24rpx;
  font-weight: 800;
}

.dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background: #d9f99d;
}

.top-note {
  color: rgba(255, 255, 255, 0.76);
  font-size: 24rpx;
}

.hero-title {
  display: block;
  font-size: 52rpx;
  line-height: 1.24;
  font-weight: 800;
}

.hero-desc {
  display: block;
  margin-top: 20rpx;
  color: rgba(255, 255, 255, 0.82);
  font-size: 28rpx;
  line-height: 1.7;
}

.content {
  padding: 28rpx;
  display: grid;
  gap: 20rpx;
}

.section {
  background: #fff;
  border: 1rpx solid #e2e8f0;
  border-radius: 16rpx;
  padding: 26rpx;
}

.empty-card {
  min-height: 360rpx;
  display: grid;
  place-items: center;
  text-align: center;
}

.avatar {
  width: 116rpx;
  height: 116rpx;
  border-radius: 50%;
  background: #eff6ff;
  border: 1rpx solid #d8e1ec;
  display: grid;
  place-items: center;
  color: #13315c;
  font-size: 42rpx;
  font-weight: 800;
  line-height: 116rpx;
}

.empty-title {
  color: #172033;
  font-size: 32rpx;
  font-weight: 800;
}

.empty-desc,
.row-desc {
  color: #64748b;
  font-size: 24rpx;
  line-height: 1.45;
}

.order-card {
  display: grid;
  gap: 20rpx;
}

.row-item {
  display: grid;
  grid-template-columns: 52rpx 1fr 110rpx;
  gap: 20rpx;
  align-items: start;
}

.mark {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  display: grid;
  place-items: center;
  font-size: 22rpx;
  font-weight: 800;
  background: #ecfdf5;
  color: #047857;
  line-height: 48rpx;
  text-align: center;
}

.row-title {
  display: block;
  font-size: 28rpx;
  color: #172033;
  font-weight: 800;
  margin-bottom: 6rpx;
}

.status {
  color: #047857;
  background: #ecfdf5;
  border-radius: 999rpx;
  padding: 8rpx 12rpx;
  text-align: center;
  font-weight: 800;
  font-size: 24rpx;
}

.price-row {
  display: grid;
  grid-template-columns: 96rpx 1fr;
  gap: 20rpx;
  padding: 20rpx;
  border-radius: 16rpx;
  background: #f8fafc;
  border: 1rpx solid #e2e8f0;
}

.price-label {
  height: 56rpx;
  border-radius: 16rpx;
  display: grid;
  place-items: center;
  color: #fff;
  background: #2563eb;
  font-size: 26rpx;
  line-height: 56rpx;
  text-align: center;
}

.price {
  display: block;
  color: #dc2626;
  font-size: 44rpx;
  font-weight: 800;
  margin-bottom: 8rpx;
}

.secondary-btn {
  height: 88rpx;
  border: 1rpx solid #d8e1ec;
  border-radius: 16rpx;
  background: #fff;
  color: #13315c;
  font-size: 28rpx;
  font-weight: 800;
  display: flex;
  align-items: center;
  justify-content: center;
}
