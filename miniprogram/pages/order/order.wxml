<view class="page">
  <view class="hero compact">
    <view class="topline">
      <view class="badge"><view class="dot"></view><text>订单</text></view>
      <text class="top-note">支付记录</text>
    </view>
    <text class="hero-title">我的订单</text>
    <text class="hero-desc">区分商品、金额、状态和“查看报告”动作。</text>
  </view>

  <view class="content">
    <view class="section empty-card" wx:if="{{loading}}">
      <text class="empty-title">加载中...</text>
      <text class="empty-desc">正在同步订单记录</text>
    </view>

    <view class="section empty-card" wx:elif="{{orders.length === 0}}">
      <view class="avatar">空</view>
      <text class="empty-title">暂无订单记录</text>
      <text class="empty-desc">解锁报告后，订单会自动同步到这里。</text>
    </view>

    <block wx:else>
      <view class="section order-card" wx:for="{{orders}}" wx:key="_id" bindtap="goToReport" data-id="{{item.recordId}}">
        <view class="row-item">
          <view class="mark">{{index + 1}}</view>
          <view>
            <text class="row-title">{{item.description || '职业与志愿分析报告解锁'}}</text>
            <text class="row-desc">订单号：{{item.outTradeNo}}</text>
          </view>
          <text class="status">已支付</text>
        </view>
        <view class="price-row">
          <text class="price-label">¥</text>
          <view>
            <text class="price">¥{{item.priceStr}}</text>
            <text class="row-desc">{{item.createTimeStr}}，可点击查看报告。</text>
          </view>
        </view>
        <button class="secondary-btn">查看报告</button>
      </view>
    </block>
  </view>
</view>
