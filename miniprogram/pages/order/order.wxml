<!--pages/order/order.wxml-->
<view class="container">
  <block wx:if="{{loading}}">
    <view class="loading-box">加载中...</view>
  </block>
  
  <block wx:elif="{{orders.length === 0}}">
    <view class="empty-tip">
      <text class="empty-icon">🧾</text>
      <text>暂无订单记录</text>
    </view>
  </block>

  <block wx:else>
    <view class="order-list">
      <view class="order-item" wx:for="{{orders}}" wx:key="_id" bindtap="goToReport" data-id="{{item.recordId}}">
        <view class="order-header">
          <text class="order-no">订单号：{{item.outTradeNo}}</text>
          <text class="order-status">已支付</text>
        </view>
        
        <view class="order-body">
          <view class="product-info">
            <text class="product-title">{{item.targetCareer}}</text>
            <text class="product-desc">AI 职业规划报告解锁</text>
          </view>
          <view class="price-box">
            <text class="currency">¥</text>
            <text class="amount">{{item.priceStr}}</text>
          </view>
        </view>
        
        <view class="order-footer">
          <text class="order-time">{{item.createTimeStr}}</text>
          <view class="action-btn">查看报告</view>
        </view>
      </view>
    </view>
  </block>
</view>
