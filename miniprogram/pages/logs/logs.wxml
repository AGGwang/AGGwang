<view class="page">
  <view class="hero compact">
    <view class="topline">
      <view class="badge"><view class="dot"></view><text>日志</text></view>
      <text class="top-note">调试页</text>
    </view>
    <text class="hero-title">访问与操作日志</text>
    <text class="hero-desc">开发调试页也统一风格，后续可隐藏或改为系统消息。</text>
  </view>

  <view class="content">
    <view class="section">
      <view class="section-head">
        <text class="section-title">最近日志</text>
        <text class="hint">仅调试</text>
      </view>
      <block wx:for="{{logs}}" wx:key="timeStamp" wx:for-item="log">
        <view class="log-line">
          <text>{{index + 1}}. 进入页面</text>
          <text>{{log.date}}</text>
        </view>
      </block>
      <view class="empty-small" wx:if="{{logs.length === 0}}">暂无日志</view>
    </view>

    <view class="section warn">
      <text class="paragraph">正式版可移除日志页，或改成“系统消息 / 生成记录”。</text>
    </view>
  </view>
</view>
