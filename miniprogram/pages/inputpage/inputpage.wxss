/* pages/inputpage/inputpage.wxss */
.container {
    padding: 40rpx;
    background-color: #f8f9fa;
    min-height: 100vh;
}

.form-group {
    margin-bottom: 40rpx;
    background: #fff;
    padding: 30rpx;
    border-radius: 12rpx;
    box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.02);
}

.label {
    font-size: 30rpx;
    font-weight: bold;
    color: #333;
    margin-bottom: 20rpx;
    display: block;
}

.input {
    height: 80rpx;
    font-size: 28rpx;
    border-bottom: 1rpx solid #eee;
    width: 100%;
}

.textarea {
    width: 100%;
    height: 200rpx;
    font-size: 28rpx;
    line-height: 1.5;
    border: 1rpx solid #eee;
    padding: 20rpx;
    box-sizing: border-box;
    border-radius: 8rpx;
}

.submit-btn {
    margin-top: 60rpx;
    background-color: #0052d9;
    color: white;
    font-size: 34rpx;
    font-weight: bold;
    border-radius: 50rpx;
    box-shadow: 0 8rpx 20rpx rgba(0, 82, 217, 0.3);
}

.submit-btn:active {
    background-color: #003bb3;
}