/* pages/inputpage/inputpage.wxss */
.container {
    padding: 40rpx 30rpx;
    background-color: #f8f9fa;
    min-height: 100vh;
    /* 重置 app.wxss 的影响 */
    display: block;
    height: auto;
    box-sizing: border-box;
}

.header-guide {
    margin-bottom: 40rpx;
    padding: 0 10rpx;
}

.guide-title {
    font-size: 40rpx;
    font-weight: bold;
    color: #333;
    margin-bottom: 12rpx;
    display: block;
}

.guide-desc {
    font-size: 26rpx;
    color: #666;
    line-height: 1.4;
}

.form-group {
    margin-bottom: 30rpx;
    background: #fff;
    padding: 40rpx 30rpx;
    border-radius: 20rpx;
    box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.03);
    transition: all 0.3s ease;
}

.form-group:active {
    transform: scale(0.995);
    box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.02);
}

.label {
    font-size: 30rpx;
    font-weight: 600;
    color: #333;
    margin-bottom: 24rpx;
    display: flex;
    align-items: center;
}

.label::before {
    content: '';
    width: 8rpx;
    height: 28rpx;
    background: #0052d9;
    border-radius: 4rpx;
    margin-right: 16rpx;
    display: inline-block;
}

.input {
    height: 88rpx;
    font-size: 30rpx;
    border: 2rpx solid #f0f0f0;
    border-radius: 12rpx;
    padding: 0 24rpx;
    width: 100%;
    box-sizing: border-box;
    background: #fcfcfc;
    transition: border-color 0.3s;
}

.input:focus {
    border-color: #0052d9;
    background: #fff;
}

/* 分数网格布局 */
.score-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20rpx;
}

.score-item {
    display: flex;
    flex-direction: column;
    align-items: center;
}

.subject-name {
    font-size: 26rpx;
    color: #666;
    margin-bottom: 10rpx;
}

.score-input {
    height: 80rpx;
    font-size: 28rpx;
    border: 2rpx solid #f0f0f0;
    border-radius: 12rpx;
    padding: 0 10rpx;
    width: 100%;
    box-sizing: border-box;
    background: #fcfcfc;
    text-align: center;
    transition: border-color 0.3s;
}

.score-input:focus {
    border-color: #0052d9;
    background: #fff;
}

.textarea {
    width: 100%;
    height: 280rpx;
    font-size: 30rpx;
    line-height: 1.6;
    border: 2rpx solid #f0f0f0;
    padding: 24rpx;
    box-sizing: border-box;
    border-radius: 12rpx;
    background: #fcfcfc;
    transition: border-color 0.3s;
}

.textarea:focus {
    border-color: #0052d9;
    background: #fff;
}

.submit-btn {
    margin-top: 80rpx;
    margin-bottom: 60rpx;
    background: linear-gradient(135deg, #0052d9, #003bb3);
    color: white;
    font-size: 34rpx;
    font-weight: bold;
    border-radius: 50rpx;
    height: 96rpx;
    line-height: 96rpx;
    box-shadow: 0 12rpx 24rpx rgba(0, 82, 217, 0.25);
}

.submit-btn:active {
    transform: scale(0.98);
    box-shadow: 0 6rpx 16rpx rgba(0, 82, 217, 0.2);
}