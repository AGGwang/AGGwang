.page {
  min-height: 100vh;
  background: #f8fafc;
  box-sizing: border-box;
  overflow-x: hidden;
}

.hero {
  background: #13315c;
  color: #fff;
  padding: 56rpx 36rpx 36rpx;
  box-sizing: border-box;
}

.compact {
  padding-bottom: 28rpx;
}

.topline {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 24rpx;
  margin-bottom: 32rpx;
}

.badge {
  display: inline-flex;
  align-items: center;
  gap: 14rpx;
  min-height: 56rpx;
  padding: 0 20rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.14);
  color: #d9f99d;
  font-size: 24rpx;
  font-weight: 800;
}

.dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background: #d9f99d;
}

.top-note {
  color: rgba(255, 255, 255, 0.76);
  font-size: 24rpx;
}

.hero-title {
  display: block;
  font-size: 52rpx;
  line-height: 1.24;
  font-weight: 800;
}

.hero-desc {
  display: block;
  margin-top: 20rpx;
  color: rgba(255, 255, 255, 0.82);
  font-size: 28rpx;
  line-height: 1.7;
}

.content {
  padding: 28rpx;
  display: grid;
  gap: 20rpx;
  box-sizing: border-box;
}

.section {
  background: #fff;
  border: 1rpx solid #e2e8f0;
  border-radius: 16rpx;
  padding: 26rpx;
  box-sizing: border-box;
}

.section-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 20rpx;
  margin-bottom: 20rpx;
}

.section-title {
  flex: 1;
  min-width: 0;
  color: #172033;
  font-size: 30rpx;
  font-weight: 800;
}

.hint {
  flex-shrink: 0;
  color: #64748b;
  font-size: 24rpx;
  white-space: nowrap;
}

.grid-2 {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
  gap: 18rpx 0;
  width: 100%;
}

.field {
  width: 100%;
  min-height: 84rpx;
  border: 1rpx solid #d8e1ec;
  border-radius: 16rpx;
  background: #f8fafc;
  padding: 18rpx 20rpx;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 14rpx;
  color: #334155;
  font-size: 26rpx;
  font-weight: 700;
}

.half-field {
  flex: 0 0 48%;
  width: 48%;
  max-width: 48%;
  box-sizing: border-box;
}

.picker-wrap {
  display: block;
  box-sizing: border-box;
}

.field-input {
  flex: 1;
  min-width: 0;
  text-align: right;
  color: #172033;
  font-size: 26rpx;
  font-weight: 800;
}

.picker-field {
  width: 100%;
}

.field-value {
  color: #172033;
  font-size: 26rpx;
  font-weight: 800;
}

.placeholder {
  color: #64748b;
  font-size: 26rpx;
  font-weight: 700;
}

.chip-grid {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
  gap: 18rpx 0;
  width: 100%;
}

.chip {
  width: 23%;
  height: 72rpx;
  border: 1rpx solid #d8e1ec;
  border-radius: 16rpx;
  background: #f8fafc;
  color: #334155;
  font-size: 26rpx;
  font-weight: 800;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
}

.chip.active {
  background: #ecfdf5;
  border-color: #10b981;
  color: #047857;
}

.selected-tip {
  display: block;
  margin-top: 18rpx;
  color: #64748b;
  font-size: 24rpx;
  line-height: 1.4;
}

@media (max-width: 340px) {
  .chip {
    width: 31%;
  }
}

.head-left {
  display: flex;
  align-items: center;
  gap: 16rpx;
  flex: 1;
  min-width: 0;
}

.test-btn {
  flex-shrink: 0;
  height: 52rpx;
  border: 1rpx solid #bfdbfe;
  border-radius: 999rpx;
  background: #eff6ff;
  color: #1d4ed8;
  padding: 0 18rpx;
  font-size: 24rpx;
  font-weight: 800;
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 0;
  box-sizing: border-box;
}

.choice-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.choice {
  width: 100%;
  min-height: 96rpx;
  border: 1rpx solid #d8e1ec;
  border-radius: 16rpx;
  background: #f8fafc;
  padding: 20rpx;
  display: flex;
  gap: 18rpx;
  align-items: start;
  box-sizing: border-box;
}

.choice > view:last-child {
  flex: 1;
  min-width: 0;
}

.radio {
  width: 32rpx;
  height: 32rpx;
  border-radius: 50%;
  border: 4rpx solid #94a3b8;
  margin-top: 4rpx;
}

.choice.active {
  border-color: #2563eb;
  background: #eff6ff;
}

.choice.active .radio {
  background: #2563eb;
  border-color: #2563eb;
  box-shadow: inset 0 0 0 8rpx #eff6ff;
}

.choice-title {
  display: block;
  color: #172033;
  font-size: 26rpx;
  font-weight: 800;
  margin-bottom: 6rpx;
}

.choice-desc {
  display: block;
  color: #64748b;
  font-size: 24rpx;
  line-height: 1.4;
}

.textarea {
  width: 100%;
  height: 192rpx;
  border: 1rpx solid #d8e1ec;
  border-radius: 16rpx;
  background: #f8fafc;
  padding: 20rpx;
  color: #172033;
  font-size: 26rpx;
  line-height: 1.6;
  font-weight: 700;
  box-sizing: border-box;
}

.primary-btn {
  box-sizing: border-box;
  width: 100%;
  height: 104rpx;
  border-radius: 16rpx;
  background: #13315c;
  color: #fff;
  font-size: 34rpx;
  font-weight: 800;
  box-shadow: 0 24rpx 44rpx rgba(19, 49, 92, 0.24);
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 20rpx 0 40rpx;
  padding: 0;
}

.primary-btn::after {
  border: 0;
}
