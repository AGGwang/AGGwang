.page {
  min-height: 100vh;
  background: #f8fafc;
}

.footer-space {
  padding-bottom: 150rpx;
}

.hero {
  background: #13315c;
  color: #fff;
  padding: 56rpx 36rpx 36rpx;
}

.topline {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24rpx;
  margin-bottom: 32rpx;
}

.badge {
  display: inline-flex;
  align-items: center;
  gap: 14rpx;
  min-height: 56rpx;
  padding: 0 20rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.14);
  color: #d9f99d;
  font-size: 24rpx;
  font-weight: 800;
}

.dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background: #d9f99d;
}

.top-note {
  color: rgba(255, 255, 255, 0.76);
  font-size: 24rpx;
}

.hero-title {
  display: block;
  font-size: 52rpx;
  line-height: 1.24;
  font-weight: 800;
  letter-spacing: 0;
}

.hero-desc {
  display: block;
  margin-top: 20rpx;
  color: rgba(255, 255, 255, 0.82);
  font-size: 28rpx;
  line-height: 1.7;
}

.process {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 16rpx;
  margin-top: 32rpx;
}

.process-item {
  border-radius: 16rpx;
  background: rgba(255, 255, 255, 0.12);
  padding: 18rpx;
  min-height: 116rpx;
}

.process-title {
  display: block;
  font-size: 24rpx;
  font-weight: 800;
  margin-bottom: 8rpx;
}

.process-desc {
  display: block;
  color: rgba(255, 255, 255, 0.72);
  font-size: 22rpx;
  line-height: 1.35;
}

.content {
  padding: 28rpx;
  display: grid;
  gap: 20rpx;
}

.primary-btn {
  width: 100%;
  height: 104rpx;
  border-radius: 16rpx;
  background: #13315c;
  color: #fff;
  font-size: 34rpx;
  font-weight: 800;
  box-shadow: 0 24rpx 44rpx rgba(19, 49, 92, 0.24);
  display: flex;
  align-items: center;
  justify-content: center;
}

.section {
  background: #fff;
  border: 1rpx solid #e2e8f0;
  border-radius: 16rpx;
  padding: 26rpx;
}

.warn {
  background: #fff7ed;
  border-color: #fed7aa;
}

.section-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 20rpx;
  margin-bottom: 20rpx;
}

.section-title {
  color: #172033;
  font-size: 30rpx;
  font-weight: 800;
}

.hint {
  color: #64748b;
  font-size: 24rpx;
  white-space: nowrap;
}

.feature-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16rpx;
}

.feature {
  min-height: 184rpx;
  background: #f8fafc;
  border: 1rpx solid #e2e8f0;
  border-radius: 16rpx;
  padding: 20rpx;
}

.feature-title {
  display: block;
  color: #172033;
  font-size: 28rpx;
  font-weight: 800;
  margin-bottom: 12rpx;
}

.feature-desc,
.paragraph {
  display: block;
  color: #64748b;
  font-size: 24rpx;
  line-height: 1.5;
}

.warn .paragraph {
  color: #9a3412;
}
